# ─────────────────────────────────────────────────────────────────────────────
# Garnet Fund Dashboard — local environment template
#
# Copy to .env.local and fill in real values, then restart `npm run dev`.
#   cp .env.example .env.local
#
# Fastest way to get real values if you have Vercel access:
#   vercel login
#   vercel link            # choose the "garnetfunddashboard" project
#   vercel env pull .env.local --environment=production
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED — app won't authenticate without these) ───────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Schwab (REQUIRED for live portfolio / market data) ───────────────────────
# Schwab developer portal → your app's credentials
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://127.0.0.1
ENABLE_SCHWAB_SYNC=false
# Optional: separate market-data app credentials (falls back to the trader ones)
SCHWAB_MARKET_CLIENT_ID=
SCHWAB_MARKET_CLIENT_SECRET=
SCHWAB_MARKET_REDIRECT_URL=

# ── Third-party data (optional — features degrade gracefully if unset) ───────
FMP_API_KEY=      # sector tags + earnings calendar
FRED_API_KEY=     # macro data
NEWS_API_KEY=     # news
GEMINI_API_KEY=   # AI features
