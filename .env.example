# ─────────────────────────────────────────────────────────────────────────────
# Garnet Fund Dashboard — local environment template
#
# Copy to .env.local and fill in real values, then restart `npm run dev`.
#   cp .env.example .env.local
#
# Fastest way to get real values if you have Vercel access:
#   vercel login
#   vercel link            # choose the "garnetfunddashboard" project
#   vercel env pull .env.local --environment=production
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED — app won't authenticate without these) ───────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Schwab (REQUIRED for live portfolio / market data) ───────────────────────
# Schwab developer portal → your app's credentials
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://127.0.0.1
ENABLE_SCHWAB_SYNC=false
# Optional: separate market-data app credentials (falls back to the trader ones)
SCHWAB_MARKET_CLIENT_ID=
SCHWAB_MARKET_CLIENT_SECRET=
SCHWAB_MARKET_REDIRECT_URL=

# ── Third-party data (optional — features degrade gracefully if unset) ───────
FMP_API_KEY=      # sector tags, 3-month T-bill, earnings calendar

# FRED (St. Louis Fed) — the macro release calendar on the risk board: CPI,
# PPI, PCE, payrolls, GDP, retail sales, jobless claims. Free key from
# https://fred.stlouisfed.org/docs/api/api_key.html
# Note: FOMC decision dates are NOT in FRED's release calendar; the panel says
# so rather than leaving their absence to be misread as "nothing scheduled".
FRED_API_KEY=

# ── Risk alert delivery (Risk Dashboard §4.4 routing table) ──────────────────
# Only a RED notifies. Yellow is dashboard-and-alert-log only.
# Each variable takes one address or a comma-separated list. A role with no
# address configured falls back to RISK_ALERT_EMAIL; with neither set, the
# alert is still written to the alert log and the notification log, and the
# send result names the roles that had nowhere to go.
RISK_ALERT_EMAIL=              # fallback for every role below
RISK_EMAIL_RISK_MANAGER=       # every red routes here
RISK_EMAIL_PRESIDENT=          # intraday reds + confirmed allocation breaches
RISK_EMAIL_PMS=                # relevant PM, on the intraday position limits
RISK_EMAIL_OPERATIONS=         # margin debit only (IRC §514 / UBTI exposure)
RISK_EMAIL_FACULTY=            # confirmed allocation breaches (IPS VIII.b)
# Added to EVERY message regardless of which tier fired. The routing above
# decides who must act on a breach; this is for whoever needs a copy of
# everything — the person maintaining the system, and an archive of what was
# actually sent. Comma-separated.
RISK_EMAIL_ALWAYS=

# Any SMTP provider works. Two that are known to:
#
#   Gmail   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465
#           SMTP_USER=you@gmail.com   SMTP_APP_PASSWORD=<16-char app password>
#           RISK_EMAIL_FROM is optional here, because the username IS the address.
#
#   Resend  SMTP_HOST=smtp.resend.com SMTP_PORT=465
#           SMTP_USER=resend          SMTP_APP_PASSWORD=<your re_… API key>
#           RISK_EMAIL_FROM IS REQUIRED: Resend's username is the literal word
#           "resend" for every account, so it cannot double as a From address.
#           Use an address on a domain verified in Resend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
# The From address on every alert. Required whenever SMTP_USER is not itself
# an email address; otherwise the send is refused rather than sent with a
# malformed sender.
RISK_EMAIL_FROM=

# Optional phone push for the intraday-sensitive reds (ntfy.sh, no account).
NTFY_TOPIC=

# ── Schwab re-auth reminder ──────────────────────────────────────────────────
# Schwab caps a refresh token at 7 days and will not extend it, so someone has
# to walk the OAuth flow by hand about weekly or the dashboard stops being
# live. /api/schwab/token-alert runs daily and mails these addresses once when
# the token has under 48h left, and once if it lapses anyway. Comma-separated.
# Falls back to RISK_ALERT_EMAIL when unset; with neither set the check still
# runs and reports, it just has nowhere to send.
# Whoever is on this list needs admin or developer on the dashboard to act on
# it — the re-auth button is on /admin.
SCHWAB_ALERT_EMAILS=

# Guards the cron endpoints (/api/risk/snapshot, /api/risk/intraday-check,
# /api/schwab/orders/sync, /api/schwab/token-alert).
CRON_SECRET=
